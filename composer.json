{
    "name": "marekskopal/typo3-mailchimp",
    "type": "typo3-cms-extension",
    "description": "Simple Mailchimp newsletter subscription form for TYPO3 CMS",
    "keywords": [
        "TYPO3",
        "mailchimp",
        "newsletter"
    ],
    "homepage": "https://marekskopal.com",
    "authors": [
        {
            "name": "Marek Skopal",
            "role": "Developer",
            "homepage": "https://marekskopal.com"
        }
    ],
    "license": ["GPL-2.0-or-later"],
    "require": {
        "php": ">=8.1",
        "typo3/cms-core": "^12.4",
        "typo3/cms-extbase": "^12.4"
    },
    "require-dev": {
        "phpstan/extension-installer": "^1.3",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^12.0",
        "shipmonk/phpstan-rules": "^4.0",
        "slevomat/coding-standard": "^8.14"
    },
    "autoload": {
        "psr-4": {
            "MarekSkopal\\MsMailchimp\\": "Classes/"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "ms_mailchimp"
        }
    },
    "config": {
        "platform": {
            "php": "8.1"
        },
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true,
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        }
    }
}