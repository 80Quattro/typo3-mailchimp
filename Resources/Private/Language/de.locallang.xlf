<?xml version="1.0" encoding="UTF-8"?>
<xliff version="1.2" xmlns="urn:oasis:names:tc:xliff:document:1.2">
    <file source-language="en" target-language="de" datatype="plaintext" original="messages" date="2024-01-01T00:00:00Z" product-name="ms_mailchimp">
        <header/>
        <body>
            <trans-unit id="form.email.label" resname="form.email.label">
                <source>Email</source>
                <target>E-Mail</target>
            </trans-unit>
            <trans-unit id="form.email.placeholder" resname="form.email.placeholder">
                <source>your@email.com</source>
                <target>ihre@email.de</target>
            </trans-unit>
            <trans-unit id="form.submit" resname="form.submit">
                <source>Subscribe</source>
                <target>Abonnieren</target>
            </trans-unit>
            <trans-unit id="message.success.subscribed" resname="message.success.subscribed">
                <source>Successfully subscribed!</source>
                <target>Erfolgreich abonniert!</target>
            </trans-unit>
            <trans-unit id="message.error.emailEmpty" resname="message.error.emailEmpty">
                <source>Please enter your email address.</source>
                <target>Bitte geben Sie Ihre E-Mail-Adresse ein.</target>
            </trans-unit>
            <trans-unit id="message.error.emailInvalid" resname="message.error.emailInvalid">
                <source>Please enter a valid email address.</source>
                <target>Bitte geben Sie eine gültige E-Mail-Adresse ein.</target>
            </trans-unit>
            <trans-unit id="message.error.alreadySubscribed" resname="message.error.alreadySubscribed">
                <source>This email is already subscribed.</source>
                <target>Diese E-Mail-Adresse ist bereits abonniert.</target>
            </trans-unit>
            <trans-unit id="message.error.subscriptionFailed" resname="message.error.subscriptionFailed">
                <source>Subscription failed. Please try again later.</source>
                <target>Anmeldung fehlgeschlagen. Bitte versuchen Sie es später erneut.</target>
            </trans-unit>
            <trans-unit id="message.error.configurationIncomplete" resname="message.error.configurationIncomplete">
                <source>Mailchimp configuration is incomplete.</source>
                <target>Mailchimp-Konfiguration ist unvollständig.</target>
            </trans-unit>
            <trans-unit id="message.error.general" resname="message.error.general">
                <source>An error occurred. Please try again later.</source>
                <target>Ein Fehler ist aufgetreten. Bitte versuchen Sie es später erneut.</target>
            </trans-unit>
        </body>
    </file>
</xliff>